# ISC DHCP server example (dhcpd.conf)
# Adapt to your environment. This file demonstrates one pool per VLAN. Adjust options (DNS, domain-name, lease times) accordingly.

default-lease-time 600;
max-lease-time 604800;
option domain-name "polytechnic.local";
option domain-name-servers 10.10.31.10, 8.8.8.8;

# BUSINESS VLAN (10) - 10.10.0.0/20
subnet 10.10.0.0 netmask 255.255.240.0 {
  option routers 10.10.0.1;
  range 10.10.0.10 10.10.15.254;
  option domain-name-servers 10.10.31.10, 8.8.8.8;
}

# MARKETING VLAN (20) - 10.10.16.0/21
subnet 10.10.16.0 netmask 255.255.248.0 {
  option routers 10.10.16.1;
  range 10.10.16.10 10.10.23.254;
}

# COMPUTER_SCIENCE VLAN (30) - 10.10.24.0/22
subnet 10.10.24.0 netmask 255.255.252.0 {
  option routers 10.10.24.1;
  range 10.10.24.10 10.10.27.254;
}

# ELECTRICAL VLAN (40) - 10.10.28.0/23
subnet 10.10.28.0 netmask 255.255.254.0 {
  option routers 10.10.28.1;
  range 10.10.28.10 10.10.29.254;
}

# FINE_ART VLAN (50) - 10.10.30.0/24
subnet 10.10.30.0 netmask 255.255.255.0 {
  option routers 10.10.30.1;
  range 10.10.30.10 10.10.30.250;
}

# SERVERS VLAN (60)
subnet 10.10.31.0 netmask 255.255.255.0 {
  option routers 10.10.31.1;
  range 10.10.31.100 10.10.31.200; # optional dynamic range for non-critical servers
}

# PRINTERS VLAN (70)
subnet 10.10.32.0 netmask 255.255.255.192 {
  option routers 10.10.32.1;
  range 10.10.32.10 10.10.32.62;
}

# VOIP VLAN (80)
subnet 10.10.32.64 netmask 255.255.255.192 {
  option routers 10.10.32.65;
  range 10.10.32.70 10.10.32.126;
}

# WIFI_GUEST VLAN (90)
subnet 10.10.32.128 netmask 255.255.255.128 {
  option routers 10.10.32.129;
  range 10.10.32.130 10.10.32.254;
}

# MGMT VLAN (99)
subnet 10.10.33.0 netmask 255.255.255.248 {
  option routers 10.10.33.1;
  range 10.10.33.2 10.10.33.6;
}
